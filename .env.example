# Environment Variables Example

# Backend API URL (for Frontend)
# Local: http://localhost:8000/api
# Production: https://your-backend-url.com/api
VITE_API_URL=http://localhost:8000/api

# Gemini API Key (Backend & Frontend)
# Get it from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Meitu Open Platform AIGC API (Backend only)
# Keep real AK/SK out of git. Configure these in Matrix env vars.
AIGC_AK=your_access_key_here
AIGC_SK=your_secret_key_here
AIGC_BIZ=ai-saap
AIGC_API_HOST=https://openapi-ali.meitu.com
AIGC_PUBLIC_BASE_URL=https://your-deployed-site.example.com
AIGC_MAX_POLLS=120
AIGC_POLL_INTERVAL_MS=2000
