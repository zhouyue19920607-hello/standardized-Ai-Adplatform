# Environment Variables Example

# Backend API URL (for Frontend)
# Local: http://localhost:8000/api
# Production: https://your-backend-url.com/api
VITE_API_URL=http://localhost:8000/api

# Gemini API Key (Backend & Frontend)
# Get it from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Meitu Open Platform AIGC API (Backend only)
# Keep real AK/SK out of git. Configure these in Matrix env vars.
AIGC_AK=your_access_key_here
AIGC_SK=your_secret_key_here
AIGC_BIZ=ai-saap
AIGC_API_HOST=https://openapi-ali.meitu.com
AIGC_MTLAB_API_HOST=https://openapi.mtlab.meitu.com
AIGC_AUTH_MODE=query
AIGC_PUBLIC_BASE_URL=https://your-deployed-site.example.com
AIGC_MAX_POLLS=360
AIGC_POLL_INTERVAL_MS=2000

# Optional: upload local videos to Observer public CDN before video_expand_v3_async
OBSERVER_ACCESS_ID=your_observer_access_id_here
OBSERVER_BIZ=your-bucket/default
OBSERVER_HOST=https://observer.starii-int.com
OBSERVER_CDN_DOMAIN=https://your-cdn.example.com

# Feishu Bitable usage analytics (backend only)
FEISHU_APP_ID=cli_your_app_id
FEISHU_APP_SECRET=your_app_secret
FEISHU_USAGE_WIKI_TOKEN=Z3zTwTAFViAZH4klt9NcsqNFngb
FEISHU_USAGE_TABLE_ID=tblHi5s5LQVZZ66v

# ArkClaw case-library connector (backend only)
# ARKCLAW_CASE_API_KEY must match the API Key configured in ArkClaw custom connector.
ARKCLAW_CASE_API_KEY=replace_with_a_long_random_token
CASE_VIDEO_DOWNLOAD_SECRET=replace_with_another_long_random_token
FEISHU_CASE_APP_TOKEN=B27LbHfKPawILAsy0h3cZl8in9e
FEISHU_CASE_TABLE_ID=tblq2aHcsX6TKGAV
